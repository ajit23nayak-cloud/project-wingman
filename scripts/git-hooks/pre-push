#!/usr/bin/env bash
# pre-push hook — CONVENTIONS rule 8 enforcement (added 2026-06-26)
#
# Blocks `git push` if:
#   1. Any unpushed commit modifies code files (anything outside coordination/)
#   2. AND the latest H2 header in coordination/log.md is older than 30 minutes
#
# Why this exists: Tab 1 has violated rule 8 (log every commit) 10 times in a row
# as of Commits 16 + 17. Two of those violations included false claims in commit
# messages about having logged. This hook makes the rule unbypassable except via
# explicit override.
#
# Override (use sparingly, with a chat reason):
#   SKIP_LOG_CHECK=1 git push

set -e

# --- Opt-out ----------------------------------------------------------------
if [ "${SKIP_LOG_CHECK:-0}" = "1" ]; then
  echo "[rule-8-hook] SKIP_LOG_CHECK=1 — bypassing log enforcement"
  exit 0
fi

# --- Locate the log file ----------------------------------------------------
REPO_ROOT="$(git rev-parse --show-toplevel)"
LOG_FILE="$REPO_ROOT/coordination/log.md"

if [ ! -f "$LOG_FILE" ]; then
  echo "[rule-8-hook] coordination/log.md not found — skipping check"
  exit 0
fi

# --- Identify commits being pushed ------------------------------------------
# Use upstream if set, otherwise fall back to origin/main.
REMOTE_REF="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo 'origin/main')"
COMMITS="$(git log "${REMOTE_REF}..HEAD" --format=%H 2>/dev/null || true)"

if [ -z "$COMMITS" ]; then
  # Nothing to push (could be force-push noop, or branch already up-to-date)
  exit 0
fi

# --- Detect whether any commit changes non-log code -------------------------
HAS_CODE_CHANGES=0
for sha in $COMMITS; do
  CHANGED="$(git show --name-only --format="" "$sha" 2>/dev/null || true)"
  while IFS= read -r path; do
    [ -z "$path" ] && continue
    case "$path" in
      coordination/*) ;;                     # log-only, ignore
      *) HAS_CODE_CHANGES=1; break 2 ;;     # any code file triggers check
    esac
  done <<EOF
$CHANGED
EOF
done

if [ "$HAS_CODE_CHANGES" -eq 0 ]; then
  echo "[rule-8-hook] Log-only push — allowed"
  exit 0
fi

# --- Check freshness of the latest H2 header --------------------------------
LATEST_H2="$(grep -oE '^## \[[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2} UTC' "$LOG_FILE" | tail -1 || true)"

if [ -z "$LATEST_H2" ]; then
  echo ""
  echo "  [rule-8-hook] BLOCKED — no H2 header found in coordination/log.md"
  echo "  Add at minimum:"
  echo "    ## [$(date -u +'%Y-%m-%d %H:%M UTC') | Tab N] <subject>"
  echo ""
  exit 1
fi

LATEST_TS="$(echo "$LATEST_H2" | sed -E 's/^## \[([0-9-]+) ([0-9:]+) UTC.*/\1 \2/')"
# GNU date (Linux + Git Bash on Windows) syntax
LATEST_EPOCH="$(date -d "$LATEST_TS UTC" +%s 2>/dev/null || echo "0")"

if [ "$LATEST_EPOCH" -eq 0 ]; then
  echo "[rule-8-hook] WARNING — could not parse latest H2 timestamp '$LATEST_TS'; allowing push"
  exit 0
fi

NOW_EPOCH="$(date +%s)"
AGE_MIN=$(( (NOW_EPOCH - LATEST_EPOCH) / 60 ))
MAX_AGE_MIN=30

if [ "$AGE_MIN" -gt "$MAX_AGE_MIN" ]; then
  echo ""
  echo "  =================================================================="
  echo "  RULE 8 VIOLATION — push BLOCKED"
  echo "  =================================================================="
  echo "  This push includes code changes, but the latest coordination/log.md"
  echo "  H2 header is ${AGE_MIN} minutes old (rule: must be < ${MAX_AGE_MIN} min)."
  echo ""
  echo "  Latest entry: $LATEST_H2"
  echo ""
  echo "  Fix: append a ship entry to coordination/log.md before pushing."
  echo "  Template (run, fill in <subject> and body):"
  echo ""
  echo "    cat >> coordination/log.md << 'EOF'"
  echo ""
  echo "    ## [$(date -u +'%Y-%m-%d %H:%M UTC') | Tab N] <subject>"
  echo ""
  echo "    <body>"
  echo "    EOF"
  echo ""
  echo "    git add coordination/log.md"
  echo "    git commit -m 'log: <subject>'"
  echo "    git push"
  echo ""
  echo "  Emergency override (document the reason in chat):"
  echo "    SKIP_LOG_CHECK=1 git push"
  echo "  =================================================================="
  echo ""
  exit 1
fi

echo "[rule-8-hook] OK — latest log entry ${AGE_MIN} min ago"
exit 0
